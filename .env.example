# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real value.

# ---------------------------------------------------------------- Supabase --
# Postgres connection for migrations and scripts. Use the IPv4 session pooler
# host (aws-1-<region>.pooler.supabase.com:5432); the documented direct host
# db.<ref>.supabase.co is IPv6-only.
DATABASE_URL=

# Safe in the browser: the anon key carries no privileges of its own and every
# request it makes is still filtered by row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER prefix this with NEXT_PUBLIC_. The service role bypasses row level
# security entirely. Server and scripts only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Guardian --
# Google Gemini, from https://aistudio.google.com/apikey
#
# NEVER prefix this with NEXT_PUBLIC_. It is read only in app/api/guardian/*,
# and lib/guardian/gemini.ts imports 'server-only' so a client component that
# reaches it fails the build rather than shipping the key to a browser.
#
# Leave blank to switch Guardian's AI off: the assistant then answers from the
# app's built-in rule engine instead, and says so.
GEMINI_API_KEY=

# Which model Guardian talks to. Optional; defaults to gemini-3.5-flash-lite.
# Must be a currently supported model: the 2.x names are retired and now 404.
GEMINI_MODEL=

# Optional Guardian tuning. Defaults in brackets.
GUARDIAN_RATE_LIMIT=          # requests per caller per window [12]
GUARDIAN_RATE_WINDOW_MS=      # window length in ms [60000]
GUARDIAN_GLOBAL_RATE_LIMIT=   # requests across all callers per window [120]
GUARDIAN_TIMEOUT_MS=          # budget for one exchange, tools included [25000]
GUARDIAN_MAX_TOOL_ROUNDS=     # tool round trips before giving up [3]
